        "npm run bench", "make bench"
      ],
      "tools": { "disabled": ["browser", "http_batch", "web_search", "transcribe", "vision", "delegate_tasks"] }
    },
    "migrator": {
      "description": "Upgrade dependencies and migrate configs; may install packages",
